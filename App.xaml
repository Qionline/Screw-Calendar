<Application x:Class="ScrewCalendar.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/DesktopWidgets.Toolkit;component/Themes/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <FontFamily x:Key="UiFont">Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>
      <SolidColorBrush x:Key="ToolkitAccentBrush" Color="#0067C0" />
      <SolidColorBrush x:Key="ToolkitInputOutlineBrush" Color="#D8E0E9" />
      <SolidColorBrush x:Key="ToolkitInputUnderlineBrush" Color="#5B6775" />
      <SolidColorBrush x:Key="ToolkitScrollThumbBrush" Color="#AEBCCA" />
      <SolidColorBrush x:Key="ToolkitScrollThumbHoverBrush" Color="#8FA0B2" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
